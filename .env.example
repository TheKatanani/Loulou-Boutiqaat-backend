# ==============================================================
# LOULOU BOUTIQAAT BACKEND - ENVIRONMENT VARIABLES FOR RENDER
# ==============================================================

# Server Runtime
PORT=10000
NODE_ENV=production

# JWT Authentication Secrets (Generate secure random strings)
ACCESS_TOKEN_SECRET=your_super_secret_access_token_key_here_at_least_32_characters
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_here_at_least_32_characters

# CORS & Frontend Origins (Comma-separated list of allowed URLs)
# Add your live frontend domain, vercel URL, render URL, or localhost:
ALLOWED_ORIGINS=https://thekatanani.com,https://www.thekatanani.com,http://localhost:3000
# Optional single frontend URL shortcut:
# FRONTEND_URL=https://thekatanani.com
# Set to true only if you want to allow requests from any origin:
# ALLOW_ALL_ORIGINS=false

# ==============================================================
# DATABASE CONFIGURATION
# Note: If no database is provided, the API automatically operates
# in Mock Fallback Mode with realistic demo data and accounts!
# ==============================================================

# Option 1: Full Connection String (Standard in Render / Aiven / Railway / Supabase)
# DATABASE_URL=mysql://user:password@host:port/dbname

# Option 2: Individual Connection Variables
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=loulouboutiqaat
# DB_DIALECT=mysql
# Set DB_SSL=true if your cloud database requires SSL (e.g. PlanetScale, Aiven, Railway)
# DB_SSL=false
